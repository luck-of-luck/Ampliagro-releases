# Ampliagro - Production Environment Variables
# Copy to .env and fill in your values

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=your-super-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=ampliagro.com,www.ampliagro.com,api.ampliagro.com

# Database (PostgreSQL)
POSTGRES_DB=ampliagro
POSTGRES_USER=ampliagro
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Agendador da varredura proativa — ESCOLHE UM, NAO OS DOIS
# ===========================================================
# A varredura proactiva corre por DOIS mecanismos possiveis, e ambos estao
# escritos no codigo:
#
#   A. Agendador do Windows (DUAS tarefas: 07:12 e 17:12)
#      instalado por `tools\bat\setup_tarefa_proativa.bat`
#
#   B. Celery BEAT — o que ESTA flag arma (app/ia/proativo_tasks.py:274)
#
# A e' a escolha correcta, e o proprio .bat argumenta porque: para um job de
# alguns segundos duas vezes ao dia, um broker e' infraestrutura a mais. Redis nao
# tem build oficial no Windows, e cada "o alerta nao veio" vira "o Redis caiu".
#
# O QUE ACONTECE SE LIGARES OS DOIS
# ---------------------------------
# A varredura corre DUAS vezes. O dedup segura o alerta duplicado — e e' por isso
# que isto e' PERIGOSO e nao visivel: parece funcionar. Nao ligues sem desligar o
# outro.
#
# Para desligar o Windows:  tools\bat\setup_tarefa_proativa.bat --remove
#
# Guarda: tests/test_agendador_unico.py falha se os dois estiverem armados.
AMPLIA_CELERY_BEAT=0

# TimescaleDB (Telemetry)
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_NAME=ampliagro_ts
TIMESCALEDB_USER=${POSTGRES_USER}
TIMESCALEDB_PASSWORD=${POSTGRES_PASSWORD}

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Ampliagro <noreply@ampliagro.com>

# Weather APIs
INMET_API_KEY=
OPENWEATHER_API_KEY=
OPEN_METEO_API_KEY=

# Market Data
AGRODOC_API_KEY=
CEPEA_API_KEY=
B3_API_KEY=

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ampliagro.com

# PWA
PWA_SERVICE_WORKER_PATH=/sw.js
PWA_MANIFEST_PATH=/manifest.json

# Storage
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
STATIC_URL=/static/

# Backup
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1

# Monitoring
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Rate Limiting
RATE_LIMIT_LOGIN=5/m
RATE_LIMIT_API=1000/hour
RATE_LIMIT_NFE=20/h

# Recuperacao de senha — MOSTRAR O CODIGO NO HTTP
# NUNCA ligado por omissao. O codigo de recuperacao e' uma CREDENCIAL: se
# voltar no corpo do POST /login/, "recuperar senha" passa a ser "entrar sem
# senha" para quem saiba usuario + email + fazenda. Por omissao so existe no
# e-mail. Ligue isto APENAS em desenvolvimento local, e saiba que cada
# exposicao fica registada:
#   [warning] codigo_recuperacao_exposto_no_http ... username=<alvo>
# A tela (login.html) trata a ausencia do campo e mostra "Se os dados
# conferem, enviamos o codigo" — o fluxo local nao quebra com isto desligado.
# AMPLIA_DEV_MOSTRAR_CODIGO=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
