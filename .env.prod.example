# ============================================================
# BUILD-01: .env.prod.example - Production Environment Template
# ============================================================
# Copy to .env and fill in all values
# NEVER commit .env to version control!
# ============================================================

# --- Django Core ---
SECRET_KEY=your-50-char-random-secret-key-here-generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=ampliagro.com,www.ampliagro.com,api.ampliagro.com

# --- Database (PostgreSQL) ---
POSTGRES_DB=ampliagro
POSTGRES_USER=ampliagro
POSTGRES_PASSWORD=your-secure-db-password
DATABASE_URL=postgresql://ampliagro:your-secure-db-password@db:5432/ampliagro

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db

# --- Agendador da varredura proativa ---
# O `celery_beat` deste compose agenda `amplia.proativo.varrer` DUAS VEZES POR DIA
# (07:12 e 17:12, `app/ia/proativo_tasks.py:291-300`). E so agenda se esta variavel
# for "1". Sem ela, o contentor arranca, nao ha erro, e a regra da chuva, das contas
# a do desvio de orcado nunca correm.
#
# Aqui e' "1" porque em PRODUCAO o agendador e' o Celery. Nao existe Agendador de
# Tarefas do Windows dentro de um contentor.
#
# O aviso que importa, porque e' o erro facil: se em algum momento installar o
# Agendador do Windows TAMBEM (`tools\bat\setup_tarefa_proativo.bat`), a varredura
# corre duas vezes e o dedup esconde o alerta duplicado. Escolha UM. O guarda e'
# `tests/test_agendador_unico.py`.
AMPLIA_CELERY_BEAT=1

# --- Security (HTTPS) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://ampliagro.com,https://www.ampliagro.com,https://app.ampliagro.com
CORS_ALLOW_CREDENTIALS=True

# --- Email (configure for production) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Ampliagro <noreply@ampliagro.com>

# --- Caddy / Let's Encrypt ---
# Option 1: Cloudflare DNS-01 challenge (recommended for wildcard certs)
CF_API_EMAIL=your-cloudflare-email@domain.com
CF_API_KEY=your-cloudflare-global-api-key

# Option 2: Let's Encrypt HTTP-01 (default, no extra config needed)
# Just ensure port 80/443 are open and domain points to server

# --- OpenWeather API ---
OPENWEATHER_API_KEY=your-openweather-api-key

# --- Sentry (Error Tracking) ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Logging ---
LOG_LEVEL=INFO
