{
  "env": { "browser": true, "es2021": true },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "prettier/prettier": ["warn", { "singleQuote": true, "semi": true, "printWidth": 100 }]
  },
  "ignorePatterns": ["node_modules/", "app/static/js/pwa/sw.js"]
}
