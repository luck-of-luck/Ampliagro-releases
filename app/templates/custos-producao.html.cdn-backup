{% extends base_template %}
{% load static %}
{% block title %}Ampliagro - Custo de Produção{% endblock %}
{% block extra_css %}

{% endblock %}
{% block dashboard_appbar %}{% endblock %}
{% block content %}
<div class="section-container">
    <div class="section-header">
        <h1 class="section-title"><i class="bi bi-calculator me-2"></i>Custo de Produção</h1>
        <div style="display:flex;gap:0.75rem;">
            <select class="search-input" id="safra-select" style="flex:0 0 auto;min-width:180px;" onchange="carregarCustos()">
                <option value="">Todas as Safras</option>
            </select>
            <button class="btn-primary" onclick="recalcular()"><i class="bi bi-arrow-repeat"></i> Recalcular</button>
            <a href="{% url 'dre-view' %}" class="btn-secondary" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;"><i class="bi bi-file-text"></i> Ver DRE</a>
            <a href="{% url 'orcamento-realizado' %}" class="btn-secondary" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;"><i class="bi bi-clipboard-data"></i> Orcado x Realizado</a>
        </div>
    </div>

    <div class="stats-grid" id="stats-grid">
        <div class="stat-card"><div class="stat-value" id="stat-custo-total">--</div><div class="stat-label">Custo Total</div></div>
        <div class="stat-card"><div class="stat-value" id="stat-por-ha">--</div><div class="stat-label">Custo / ha</div></div>
        <div class="stat-card"><div class="stat-value" id="stat-por-saca">--</div><div class="stat-label">Custo / Saca</div></div>
        <div class="stat-card"><div class="stat-value" id="stat-receita">--</div><div class="stat-label">Receita</div></div>
        <div class="stat-card"><div class="stat-value" id="stat-lucro">--</div><div class="stat-label">Lucro</div></div>
        <div class="stat-card"><div class="stat-value" id="stat-margem">--</div><div class="stat-label">Margem</div></div>
    </div>

    <div class="chart-row">
        <div class="content-card">
            <div class="card-title"><i class="bi bi-pie-chart"></i> Custo por Categoria</div>
            <div class="chart-box"><canvas id="chart-categorias"></canvas></div>
        </div>
        <div class="content-card">
            <div class="card-title"><i class="bi bi-bar-chart"></i> Custo por Safra</div>
            <div class="chart-box"><canvas id="chart-safras"></canvas></div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-title"><i class="bi bi-table"></i> Detalhamento por Safra / Talhão</div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Safra</th><th>Talhão</th><th>Insumos</th><th>Máquina</th><th>Mão de Obra</th><th>Custo Total</th><th>R$/ha</th><th>R$/sc</th><th>Margem</th></tr>
                </thead>
                <tbody id="tabela-custos">
                    <tr><td colspan="9" class="empty-state">Carregando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
{{ block.super }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function(){
    let custos=[];
    function getCSRF(){ return document.querySelector('[name=csrfmiddlewaretoken]')?.value || ''; }
    function fmt(v){ if(v==null) return '--'; return 'R$ '+parseFloat(v).toLocaleString('pt-BR',{minimumFractionDigits:2}); }
    function pct(v){ if(v==null) return '--'; return (parseFloat(v)*100).toFixed(1)+'%'; }

    async function carregarSafras(){
        try{ const r=await fetch('/api/safras/'); if(!r.ok) return; let d=await r.json(); if(d.results) d=d.results; const sel=document.getElementById('safra-select'); d.forEach(s=>{ const o=document.createElement('option'); o.value=s.id; o.textContent=(s.safra_nome||s.cultura_nome||'Safra')+' '+s.ano; sel.appendChild(o); }); }catch(e){}
    }
    async function carregarCustos(){
        const safraId=document.getElementById('safra-select').value;
        let url='/api/custos-producao/';
        if(safraId) url+='?safra='+safraId;
        try{
            const r=await fetch(url);
            if(!r.ok) throw 1;
            let d=await r.json(); if(d.results) d=d.results;
            custos=d;
            renderTabela();
            renderStats();
            renderCharts();
        }catch(e){ document.getElementById('tabela-custos').innerHTML='<tr><td colspan=\"9\" class=\"empty-state\">Erro ao carregar custos. Clique em Recalcular.</td></tr>'; }
    }
    function renderTabela(){
        const tbody=document.getElementById('tabela-custos');
        if(!custos.length){ tbody.innerHTML='<tr><td colspan=\"9\" class=\"empty-state\">Nenhum custo calculado. Clique em Recalcular.</td></tr>'; return; }
        let html='';
        custos.forEach(c=>{
            const margem=c.margem!=null?'<span class=\"badge '+(parseFloat(c.margem)>=0?'badge-success':'badge-danger')+'\">'+pct(c.margem)+'</span>':'--';
            html+='<tr><td>'+(c.safra_nome||'#'+c.safra)+'</td><td>'+(c.talhao_nome||'— (safra)')+'</td>'
                +'<td>'+fmt(c.insumos)+'</td><td>'+fmt(c.maquina)+'</td><td>'+fmt(c.mao_de_obra)+'</td>'
                +'<td><strong>'+fmt(c.custo_total)+'</strong></td><td>'+fmt(c.custo_por_ha)+'</td><td>'+fmt(c.custo_por_saca)+'</td><td>'+margem+'</td></tr>';
        });
        tbody.innerHTML=html;
    }
    function renderStats(){
        if(!custos.length){ ['custo-total','por-ha','por-saca','receita','lucro','margem'].forEach(id=>{ document.getElementById('stat-'+id).textContent='--'; }); return; }
        const tot=custos.reduce((s,c)=>s+parseFloat(c.custo_total||0),0);
        const avgHa=custos.length?custos.reduce((s,c)=>s+(parseFloat(c.custo_por_ha)||0),0)/custos.length:0;
        const avgSc=custos.length?custos.reduce((s,c)=>s+(parseFloat(c.custo_por_saca)||0),0)/custos.length:0;
        const receita=custos.reduce((s,c)=>s+(parseFloat(c.receita)||0),0);
        const lucro=custos.reduce((s,c)=>s+(parseFloat(c.lucro)||0),0);
        const margem=receita?lucro/receita:null;
        document.getElementById('stat-custo-total').textContent=fmt(tot);
        document.getElementById('stat-por-ha').textContent=fmt(avgHa);
        document.getElementById('stat-por-saca').textContent=fmt(avgSc);
        document.getElementById('stat-receita').textContent=fmt(receita);
        const lucroEl=document.getElementById('stat-lucro'); lucroEl.textContent=fmt(lucro); lucroEl.className='stat-value '+(lucro>=0?'positive':'negative');
        document.getElementById('stat-margem').textContent=margem!=null?pct(margem):'--';
    }
    let chartCat=null, chartSafra=null;
    function renderCharts(){
        const catCtx=document.getElementById('chart-categorias');
        const safCtx=document.getElementById('chart-safras');
        if(!custos.length) return;
        // Categorias
        const cats={ insumos:0, maquina:0, mao_de_obra:0, embalagem:0, frete:0, impostos:0, outros:0 };
        custos.forEach(c=>{ Object.keys(cats).forEach(k=> cats[k]+=parseFloat(c[k]||0)); });
        const catLabels={ insumos:'Insumos', maquina:'Máquina', mao_de_obra:'Mão de Obra', embalagem:'Embalagem', frete:'Frete', impostos:'Impostos', outros:'Outros' };
        const catData=Object.entries(cats).filter(([,v])=>v>0);
        if(chartCat) chartCat.destroy();
        if(catData.length && window.Chart){
            chartCat=new Chart(catCtx,{ type:'doughnut', data:{ labels: catData.map(([k])=>catLabels[k]||k), datasets:[{ data: catData.map(([,v])=>v), backgroundColor:['#006b68','#f59e0b','#3b82f6','#10b981','#ef4444','#8b5cf6','#64748b'] }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } } });
        }
        // Safras
        if(chartSafra) chartSafra.destroy();
        if(window.Chart){
            chartSafra=new Chart(safCtx,{ type:'bar', data:{ labels: custos.map(c=>c.safra_nome||'#'+c.safra), datasets:[{ label:'Custo Total', data: custos.map(c=>parseFloat(c.custo_total||0)), backgroundColor:'#006b68' },{ label:'Receita', data: custos.map(c=>parseFloat(c.receita||0)), backgroundColor:'#10b981' }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } } });
        }
    }
    window.carregarCustos=carregarCustos;
    window.recalcular=async function(){
        const safraId=document.getElementById('safra-select').value;
        const btn=event?.target?.closest('button');
        if(btn){ btn.disabled=true; btn.innerHTML='<i class=\"bi bi-hourglass-split\"></i> Recalculando...'; }
        try{
            const payload=safraId?{safra_ids:[parseInt(safraId)]}:{};
            // se nenhuma safra selecionada, recalcula todas (pegar primeira propriedade via safras)
            if(!safraId){
                const rs=await fetch('/api/safras/'); if(rs.ok){ let sd=await rs.json(); if(sd.results) sd=sd.results; if(sd.length) payload.safra_ids=sd.map(s=>s.id); }
            }
            const r=await fetch('/api/custos-producao/recalcular/',{ method:'POST', headers:{'Content-Type':'application/json','X-CSRFToken':getCSRF()}, body:JSON.stringify(payload) });
            if(!r.ok){ const e=await r.json(); alert('Erro: '+JSON.stringify(e)); } else carregarCustos();
        }catch(e){ alert('Erro de conexão'); }
        if(btn){ btn.disabled=false; btn.innerHTML='<i class=\"bi bi-arrow-repeat\"></i> Recalcular'; }
    };
    document.addEventListener('DOMContentLoaded', function(){ carregarSafras(); carregarCustos(); });
})();
</script>
{% endblock %}
