<!-- Planilha Rapida (Bulk Data Entry) -->
<div
  id="quick-spreadsheet-modal"
  onclick="closeQuickSpreadsheet()"
  class="fixed inset-0 z-[1002] hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm"
>
  <div
    onclick="event.stopPropagation()"
    class="bg-white dark:bg-[#131917] rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700/60 flex flex-col overflow-hidden transition-all duration-200 scale-95 opacity-0"
    style="width: 800px; max-width: 95vw; max-height: 85vh"
    id="quick-spreadsheet-panel"
  >
    <div
      class="flex items-center justify-between px-3 py-2 border-b border-slate-200 dark:border-slate-700/60 shrink-0"
    >
      <div class="flex items-center gap-2">
        <div
          class="w-6 h-6 flex items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"
        >
          <i class="bi bi-table text-[11px]"></i>
        </div>
        <div>
          <span class="text-[12px] font-bold text-slate-800 dark:text-slate-100"
            >Entrada Rapida</span
          >
          <p class="text-[7px] text-slate-400">Registros em lote | Tab/Enter navega</p>
        </div>
      </div>
      <button
        onclick="closeQuickSpreadsheet()"
        class="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/50 text-slate-400"
      >
        <i class="bi bi-x-lg text-[10px]"></i>
      </button>
    </div>
    <div
      class="flex items-center gap-2 px-3 py-1.5 border-b border-slate-200 dark:border-slate-700/60 shrink-0"
    >
      <select
        id="qs-type"
        class="text-[9px] px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200"
        onchange="rebuildQuickSheet()"
      >
        <option value="producao">Producao/Safra</option>
        <option value="pesagem">Pesagem de Animais</option>
        <option value="insumo">Aplicacao de Insumos</option>
        <option value="financeiro">Lancamento Financeiro</option>
        <option value="produto">Produtos / Precificacao</option>
      </select>
      <select
        id="qs-rows"
        class="text-[9px] px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200"
        onchange="rebuildQuickSheet()"
      >
        <option value="5">5 linhas</option>
        <option value="10" selected>10 linhas</option>
        <option value="20">20 linhas</option>
        <option value="50">50 linhas</option>
      </select>
      <div class="flex-1"></div>
      <button
        onclick="saveQuickSheet()"
        class="px-3 py-1 text-[9px] font-semibold rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all"
      >
        <i class="bi bi-check-lg mr-1"></i>Salvar Tudo
      </button>
    </div>
    <div class="flex-1 overflow-auto scrollbar-none px-3 py-1" id="qs-grid-container"></div>
  </div>
</div>

