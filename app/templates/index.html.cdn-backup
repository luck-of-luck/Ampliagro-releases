      <div class="nav-mode-card-name">Claro</div>
    </div>
    <div
      class="nav-mode-card"
      data-preset="personalizado"
      role="button"
      tabindex="0"
      onclick="selectPreset('personalizado', event)"
    >
      <div class="nav-mode-card-head">
        <span class="nav-mode-card-title"
          ><i class="bi bi-palette"></i><span>Personalizado</span></span
        ><span class="nav-mode-card-badge">Ativo</span>
      </div>
      <div class="nav-mode-card-preview">
        <div class="nmc-pv" style="background: #0b0f0e; border-color: #33413f">
          <div class="nmc-pv-nav" style="background: #131917; border-color: #33413f">
            <i class="nmc-pv-acc" style="background: #3ec48f"></i
            ><i class="nmc-pv-line" style="background: #8b9792"></i>
          </div>
          <div class="nmc-pv-row">
            <div class="nmc-pv-card" style="background: #151b19; border-color: #33413f">
              <span class="nmc-pv-vbar" style="background: #3ec48f; height: 55%"></span
              ><span class="nmc-pv-vbar" style="background: #3ec48f; height: 85%"></span>
            </div>
            <div
              class="nmc-pv-card nmc-pv-card-nest"
              style="background: #1a211f; border-color: #33413f"
            >
              <i class="nmc-pv-acc" style="background: #57d7a0"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-mode-card-name">Personalizado</div>
    </div>
  </div>
  <div style="padding: 0.5rem; text-align: center">
    <button
      type="button"
      class="btn-personalizar-mode"
      onclick="openPersonalizarMode(event)"
      style="width: 100%"
    >
      Personalizar
    </button>
  </div>
</div>

<script>
  // nav-brand como botão de tema com ícone sol/lua/p e menu centralizado
  function updateNavBrandIcon() {
    try {
      const icon = document.getElementById('nav-brand-icon');
      if (!icon) return;
      let modo = 'claro';
      const active = document.querySelector('.nav-mode-card.is-active');
      if (active) modo = active.dataset.preset || 'claro';
      else {
        const raw =
          localStorage.getItem('ampliagro-preferences') ||
          localStorage.getItem('ampliagro-preferences_u' + (window.AMPLIAGRO_USER_ID || ''));
        if (raw) {
          try {
            const prefs = JSON.parse(raw);
            if (prefs.theme && prefs.theme.mode) modo = prefs.theme.mode;
          } catch (e) {}
        }
        if (document.documentElement.classList.contains('dark') && modo === 'claro')
          modo = 'escuro';
      }
      modo = String(modo).toLowerCase();
      const sunSVG =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
      const moonSVG =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
      const pSVG =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.563-5.554C21.965 6.012 17.461 2 12 2z"></path></svg>';
      if (modo.includes('escuro') || modo.includes('dark') || modo.includes('noite'))
        icon.innerHTML = moonSVG;
      else if (modo.includes('personal') || modo.includes('custom') || modo === 'p')
        icon.innerHTML = pSVG;
      else icon.innerHTML = sunSVG;
    } catch (e) {}
  }
  function toggleModeCentered(e) {
    if (e) e.stopPropagation();
    const dd = document.getElementById('mode-dropdown');
    if (!dd) return;
    dd.style.display = '';
    const isOpen = dd.classList.contains('is-open');
    if (isOpen) {
      dd.classList.remove('is-open', 'is-centered');
      dd.classList.add('hidden');
    } else {
      dd.classList.remove('hidden');
      dd.classList.add('is-open', 'is-centered');
      if (window.refreshModePanel) window.refreshModePanel();
      updateNavBrandIcon();
      document.querySelectorAll('.nav-mega.is-open').forEach((m) => m.classList.remove('is-open'));
      const ud = document.getElementById('user-dropdown');
      if (ud) ud.classList.remove('is-open');
      if (ud) ud.classList.add('hidden');
    }
  }
  const _origToggleModeDropdownIdx = window.toggleModeDropdown;
  window.toggleModeDropdown = function (e) {
    return toggleModeCentered(e);
  };
  const _origCloseModeDropdownIdx = window.closeModeDropdown;
  window.closeModeDropdown = function () {
    const dd = document.getElementById('mode-dropdown');
    if (dd) {
      dd.classList.remove('is-open', 'is-centered');
      dd.classList.add('hidden');
    }
    if (typeof _origCloseModeDropdownIdx === 'function')
      try {
        _origCloseModeDropdownIdx();
      } catch (e) {}
  };
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(updateNavBrandIcon, 300);
  });
  const _origRefreshIdx = window.refreshModePanel;
  window.refreshModePanel = function () {
    if (typeof _origRefreshIdx === 'function')
      try {
        _origRefreshIdx();
      } catch (e) {}
    updateNavBrandIcon();
  };
  const _origSelectModeIdx = window.selectMode;
  window.selectMode = function (mode, e) {
    if (e) e.stopPropagation();
    if (typeof _origSelectModeIdx === 'function') _origSelectModeIdx(mode, e);
    else {
      closeModeDropdown();
      if (typeof window.setTheme === 'function') window.setTheme(mode);
    }
    setTimeout(updateNavBrandIcon, 100);
  };
  // Fallback for onceEvent AND onEvent/offEvent in case spa.js hasn't loaded yet
  window.onceEvent =
    window.onceEvent ||
    function (type, handler) {
      document.addEventListener(
        type,
        function (e) {
          handler(e);
        },
        { once: true }
      );
    };

  window.onEvent =
    window.onEvent ||
    function (type, handler, options) {
      document.addEventListener(type, handler, options);
    };

  window.offEvent =
    window.offEvent ||
    function (type, handler) {
      document.removeEventListener(type, handler);
    };

  window.onceEvent('DOMContentLoaded', function () {
    try {
      updateConnectionStatus();
    } catch (e) {
      console.warn('Falha ao atualizar status de conexão:', e);
    }
    initNavPremium();
    try {
      /* Restaura SEMPRE o tema a partir do JSON do usuário
       (modos válidos: claro | escuro | custom) */
      var modoRestaurado =
        typeof window.restaurarTemaDoUsuario === 'function'
          ? window.restaurarTemaDoUsuario()
          : null;
      if (!modoRestaurado) {
        var saved = window.getPreferences();
        window.syncModeDropdown(saved.theme.mode);
      }
    } catch (e) {}
    try {
      renderWidgetbarPresets();
    } catch (e) {
      console.warn('Falha ao renderizar presets:', e);
    }
  });

  function initNavPremium() {
    var nav = document.getElementById('nav-premium');
    if (!nav) return;

    if (typeof window.updateNavActive === 'function') {
      window.updateNavActive();
    } else {
      var path = window.location.pathname;
      var pills = nav.querySelectorAll('.nav-pill[data-pill]');
      pills.forEach(function (p) {
        p.classList.remove('is-active');
      });
      pills.forEach(function (p) {
        var pill = p.getAttribute('data-pill');
        if (
          (pill === 'dashboard' && (path === '/' || path.indexOf('index') > -1 || path === '')) ||
          path.indexOf(pill) > -1
        ) {
          p.classList.add('is-active');
        }
      });
    }
  }

  window.toggleMega = function (id) {
    var menu = document.getElementById(id);
    if (!menu) return;
    var isOpen = menu.classList.contains('is-open');
    document.querySelectorAll('.nav-mega.is-open').forEach(function (m) {
      m.classList.remove('is-open');
    });
    if (!isOpen) {
      menu.classList.add('is-open');
    }
  };

  document.addEventListener('click', function (e) {
    var group = e.target.closest('.nav-pill-group');
    if (!group) {
      document.querySelectorAll('.nav-mega.is-open').forEach(function (m) {
        m.classList.remove('is-open');
      });
    } else {
      var mega = e.target.closest('.nav-mega');
      if (mega) {
        mega.classList.remove('is-open');
      }
    }
  });

  window.toggleUserDropdown = function (e) {
    e.stopPropagation();
    var dd = document.getElementById('user-dropdown');
    if (!dd) return;
    var isOpen = dd.classList.contains('is-open');
    if (isOpen) {
      dd.classList.remove('is-open');
      dd.classList.add('hidden');
    } else {
      dd.classList.remove('hidden', 'open');
      dd.classList.add('is-open');
      var md = document.getElementById('mode-dropdown');
      if (md) md.classList.remove('is-open');
    }
  };

  window.logoutUser = function (e) {
    e.preventDefault();
    e.stopPropagation();
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '{% url "logout" %}';
    var csrf = document.createElement('input');
    csrf.type = 'hidden';
    csrf.name = 'csrfmiddlewaretoken';
    csrf.value = (typeof getCookie === 'function' && getCookie('csrftoken')) || '';
    form.appendChild(csrf);
    document.body.appendChild(form);
    form.submit();
  };

  document.addEventListener('click', function (e) {
    var dd = document.getElementById('user-dropdown');
    if (dd && !e.target.closest('.nav-user')) {
      dd.classList.remove('is-open');
    }
  });

  window.toggleModeDropdown = function (e) {
    return toggleModeCentered(e);
  };
  window.closeModeDropdown = function () {
    var dd = document.getElementById('mode-dropdown');
    if (dd) {
      dd.classList.remove('is-open', 'is-centered');
      dd.classList.add('hidden');
    }
  };
  window.selectMode = function (mode, e) {
    if (e) e.stopPropagation();
    window.closeModeDropdown();
    if (typeof window.setTheme === 'function') window.setTheme(mode);
  };
  document.addEventListener('click', function (e) {
    var dd = document.getElementById('mode-dropdown');
    if (dd && !e.target.closest('#nav-brand-theme-box') && !e.target.closest('#mode-dropdown')) {
      dd.classList.remove('is-open', 'is-centered');
      dd.classList.add('hidden');
    }
  });
</script>
{% endblock %} {% block marketplace_modal %}{% endblock %} {% block dashboard_appbar %}{% include 'partials/dashboard_appbar.html' %}{% endblock %} {% block content %}
<div class="matrix-container" style="--grid-cols: 64; --grid-rows: 40"></div>
{% endblock %} {% block custom_theme_modal %}
<!-- Modal de Personalização de Tema -->
<div
  id="custom-theme-modal"
  class="fixed inset-0 z-[2147483647] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="custom-theme-title"
  aria-describedby="custom-theme-description"
  aria-hidden="true"
>
  <div
    class="custom-theme-backdrop absolute inset-0 bg-slate-950/50 backdrop-blur-sm"
    onclick="closeCustomThemeModal()"
  ></div>
  <section
    class="custom-theme-card relative w-full max-w-xl rounded-2xl border border-slate-300/50 dark:border-slate-600/50 bg-white dark:bg-slate-900 shadow-2xl"
    onclick="event.stopPropagation()"
  >
    <header
      class="flex items-start justify-between gap-4 border-b border-slate-200 dark:border-slate-700 px-5 py-4"
    >
      <div>
        <h2
          id="custom-theme-title"
          class="text-base font-semibold text-slate-800 dark:text-slate-100"
        >
          Personalizar tema
        </h2>
        <p id="custom-theme-description" class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Altere cores e escolha onde o tema deve ser aplicado.
        </p>
      </div>
      <button
        id="custom-theme-close"
        type="button"
        onclick="closeCustomThemeModal()"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-800 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        aria-label="Fechar personalização de tema"
      >
        <i class="bi bi-x-lg"></i>
      </button>
    </header>
    <div class="grid gap-5 px-5 py-5 md:grid-cols-2">
      <div class="md:col-span-2">
        <h3
          class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
        >
          Começar de
        </h3>
        <select
          id="custom-theme-base"
          onchange="presetBaseChange()"
          class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
        >
          <option value="">Padrão vazio</option>
        </select>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Vazio traz as cores padrão; "Clonar" copia as cores de um preset existente para ajustar.
        </p>
      </div>
      <div>
        <h3
          class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
        >
          Aplicar em
        </h3>
        <div class="space-y-2">
          <label
            class="theme-modal-option flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500"
            ><span>Navbar</span
            ><input
              id="custom-theme-option-navbar"
              class="h-4 w-4"
              type="checkbox"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="theme-modal-option flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500"
            ><span>Workspace</span
            ><input
              id="custom-theme-option-workspace"
              class="h-4 w-4"
              type="checkbox"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="theme-modal-option flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500"
            ><span>Widgetbar</span
            ><input
              id="custom-theme-option-widgetbar"
              class="h-4 w-4"
              type="checkbox"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="theme-modal-option flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-slate-400 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500"
            ><span>Modo escuro</span
            ><input
              id="custom-theme-option-dark"
              class="h-4 w-4"
              type="checkbox"
              onchange="applyCustomTheme()"
          /></label>
        </div>
      </div>
      <div>
        <h3
          class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
        >
          Cores
        </h3>
        <div class="grid grid-cols-2 gap-3">
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Acento<input
              id="custom-theme-accent"
              class="theme-color-input"
              type="color"
              value="#0f9d6e"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Texto<input
              id="custom-theme-text"
              class="theme-color-input"
              type="color"
              value="#e9eeec"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Navbar<input
              id="custom-theme-navbar"
              class="theme-color-input"
              type="color"
              value="#131917"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Workspace<input
              id="custom-theme-workspace"
              class="theme-color-input"
              type="color"
              value="#0b0f0e"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Cards<input
              id="custom-theme-card"
              class="theme-color-input"
              type="color"
              value="#151b19"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Widgetbar<input
              id="custom-theme-widgetbar"
              class="theme-color-input"
              type="color"
              value="#131917"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Gráfico<input
              id="custom-theme-chart"
              class="theme-color-input"
              type="color"
              value="#0f9d6e"
              onchange="applyCustomTheme()"
          /></label>
          <label
            class="flex items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300"
            >Borda<input
              id="custom-theme-border"
              class="theme-color-input"
              type="color"
              value="#33413f"
              onchange="applyCustomTheme()"
          /></label>
        </div>
        <div class="mt-3">
          <h4
            class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
          >
            Gráfico do Preset Ativo
          </h4>
          <div class="flex gap-2">
            <label class="flex-1 flex items-center justify-between gap-2 text-xs"
              >Cor 1<input
                id="custom-chart-color1"
                type="color"
                value="#0f9d6e"
                style="width: 32px; height: 24px"
                onchange="updatePresetChartColors()"
            /></label>
            <label class="flex-1 flex items-center justify-between gap-2 text-xs"
              >Cor 2<input
                id="custom-chart-color2"
                type="color"
                value="#3ec48f"
                style="width: 32px; height: 24px"
                onchange="updatePresetChartColors()"
            /></label>
          </div>
        </div>
      </div>
    </div>
    <footer
      class="flex items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-700 px-5 py-4 bg-slate-50 dark:bg-slate-800/50"
    >
      <button
        type="button"
        onclick="revertCustomTheme()"
        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300"
      >
        <i class="bi bi-arrow-counterclockwise"></i> Reverter
      </button>
      <div class="flex gap-2">
        <button
          type="button"
          onclick="closeCustomThemeModal()"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300"
        >
          Cancelar
        </button>
        <button
          type="button"
          onclick="saveCustomTheme()"
          class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-700"
        >
          <i class="bi bi-check-lg"></i> Salvar
        </button>
      </div>
    </footer>
  </section>
</div>

{% endblock %} {% block add_widget_modal %}
<!-- Modal — container captura cliques fora do painel para fechar -->
<div
  id="add-widget-modal"
  onclick="closeAddWidgetModal()"
  class="fixed inset-0 z-[2147483647] hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm transition-all"
  style="pointer-events: auto"
>
  <!-- Painel -->
  <div
    onclick="event.stopPropagation()"
    class="widget-modal-box lc-panel rounded-2xl flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-200 scale-95 opacity-0"
    style="width: 92vw; height: 74vh; max-width: 1240px; border-radius: 20px !important"
    id="add-widget-modal-panel"
  >
    <!-- Header reservado para mini-painel de cultura (oculto no modo normal; footer ja tem Cancelar) -->
    <div id="widget-modal-header" class="hidden"></div>

    <!-- Navegacao estilo Liquid Glass — abas tipo nav-tabs -->
    <div
      class="preset-tabs-container flex gap-4 px-4 pt-4 mb-3 border-b border-white/10 overflow-x-auto hide-scrollbar shrink-0"
      id="widget-nav-wrapper"
    >
      <ul class="flex gap-4" id="widget-modal-tabs" role="tablist">
        <li class="nav-item">
          <button
            class="preset-tab-btn active"
            data-modal-tab="kpi"
            onclick="switchWidgetTab('kpi')"
            role="tab"
            aria-selected="true"
          >
            <i class="bi bi-speedometer2"></i> KPIs
          </button>
        </li>
        <li class="nav-item">
          <button
            class="preset-tab-btn"
            data-modal-tab="recent"
            onclick="switchWidgetTab('recent')"
            role="tab"
          >
            <i class="bi bi-clock-history"></i> Recentes
          </button>
        </li>
        <li class="nav-item">
          <button
            class="preset-tab-btn"
            data-modal-tab="suggested"
            onclick="switchWidgetTab('suggested')"
            role="tab"
          >
            <i class="bi bi-magic"></i> IA
          </button>
        </li>
        <div id="widget-modal-tabs-cultura" class="flex gap-4" style="margin-left: 6px"></div>
      </ul>
    </div>

    <!-- Conteúdo principal (lista de categorias + accordion) -->
    <div class="flex-1 overflow-y-auto scrollbar-none px-3 py-1.5" id="widget-modal-content">
      <!-- KPIs: subcategorias accordion -->
      <div class="tab-content" data-modal-tab="kpi">
        <div id="kpi-accordion-container"></div>
      </div>
      <!-- Recentes -->
      <div class="tab-content hidden" data-modal-tab="recent" id="recent-widgets-container">
        <div class="text-[11px] font-medium text-slate-600 dark:text-slate-400 mb-3">
          Widgets usados recentemente
        </div>
        <div id="recent-widgets-grid" class="grid grid-cols-3 gap-2"></div>
      </div>
      <!-- Sugeridos por IA -->
      <div class="tab-content hidden" data-modal-tab="suggested" id="suggested-widgets-container">
        <div class="text-[11px] font-medium text-slate-600 dark:text-slate-400 mb-3">
          Sugestões baseadas no seu contexto
        </div>
        <div id="suggested-widgets-grid" class="grid grid-cols-3 gap-2"></div>
      </div>
      <!-- Conteúdo de grupos de cultura — gerado dinamicamente pelo CulturesLoader -->
    </div>

    <!-- Mini painel de cultura (escondido por padrão) -->
    <div
      id="culture-mini-panel"
      class="hidden flex-1 min-h-0 w-full overflow-y-auto scrollbar-none px-3 py-1.5"
    >
      <!-- Preenchido dinamicamente -->
    </div>

    <!-- Estado vazio global -->
    <div id="widget-modal-empty-state" class="hidden px-4 py-6 text-center shrink-0">
      <div class="flex flex-col items-center">
        <div
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-300 dark:text-slate-600 mb-2"
        >
          <i class="bi bi-search text-lg"></i>
        </div>
        <h3 class="text-[12px] font-bold text-slate-700 dark:text-slate-200 mb-0.5">
          Nenhum resultado
        </h3>
        <p class="text-[10px] text-slate-400 dark:text-slate-500">
          Tente outro termo ou explore as abas
        </p>
      </div>
      <div class="grid grid-cols-3 gap-1.5 mt-3 opacity-30">
        <div class="h-12 rounded-lg bg-slate-200 dark:bg-slate-700 animate-pulse"></div>
        <div
          class="h-12 rounded-lg bg-slate-200 dark:bg-slate-700 animate-pulse"
          style="animation-delay: 0.1s"
        ></div>
        <div
          class="h-12 rounded-lg bg-slate-200 dark:bg-slate-700 animate-pulse"
          style="animation-delay: 0.2s"
        ></div>
      </div>
    </div>

    <!-- Footer com busca à esquerda e botoes à direita -->
    <div
      id="widget-modal-footer"
      class="px-4 py-3 border-t border-white/10 flex items-center justify-between shrink-0 gap-3"
      style="position: relative; z-index: 1"
    >
      <div class="relative flex-1 max-w-[280px]">
        <i
          class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[12px] text-slate-400"
        ></i>
        <input
          type="text"
          id="widget-modal-search"
          placeholder="Pesquisar widgets..."
          class="lc-input w-full pl-8 pr-3 py-2 text-[12px]"
          oninput="filterWidgetModal()"
        />
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          onclick="closeAddWidgetModal()"
          class="lc-btn-secondary"
          style="padding: 0.4rem 0.8rem; font-size: 0.75rem; border-radius: 8px"
        >
          Cancelar
        </button>
        <button
          onclick="closeAddWidgetModal()"
          class="lc-btn"
          style="padding: 0.4rem 1rem; font-size: 0.75rem"
        >
          Salvar Widgets
        </button>
      </div>
    </div>
  </div>
</div>

