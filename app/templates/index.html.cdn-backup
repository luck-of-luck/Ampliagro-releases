        class="flex-1 text-[11px] bg-transparent text-slate-700 dark:text-slate-200 placeholder:text-slate-400 focus:outline-none"
        oninput="filterCommandPalette(this.value)"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd
        class="text-[8px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-400 font-mono border border-slate-200 dark:border-slate-700"
