      >
        Meus Produtos
      </button>
      <button
        onclick="showProductTab('cadastrar')"
        class="px-2 py-1 text-[9px] font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200"
        id="prod-tab-cadastrar"
      >
        + Novo Produto
      </button>
      <button
        onclick="showProductTab('precos')"
        class="px-2 py-1 text-[9px] font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200"
        id="prod-tab-precos"
      >
        Tabela de Precos
      </button>
    </div>
    <div
      class="flex-1 overflow-y-auto scrollbar-none px-3 py-2 text-[10px] text-slate-700 dark:text-slate-200"
      id="product-registry-content"
    ></div>
  </div>
</div>

<!-- Caderno de Campo (preview + print) -->
<div
  id="field-notebook-modal"
  onclick="closeFieldNotebook()"
  class="fixed inset-0 z-[1002] hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm"
>
  <div
    onclick="event.stopPropagation()"
    class="bg-white dark:bg-[#131917] rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700/60 flex flex-col overflow-hidden transition-all duration-200 scale-95 opacity-0"
    style="width: 800px; max-width: 95vw; max-height: 85vh"
    id="field-notebook-panel"
  >
    <div
      class="flex items-center justify-between px-3 py-2 border-b border-slate-200 dark:border-slate-700/60 shrink-0 no-print"
    >
      <div class="flex items-center gap-2">
        <div
          class="w-6 h-6 flex items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"
        >
          <i class="bi bi-journal-text text-[11px]"></i>
        </div>
        <span class="text-[12px] font-bold text-slate-800 dark:text-slate-100"
          >Caderno de Campo</span
        >
      </div>
      <div class="flex items-center gap-1">
        <button
          onclick="printFieldNotebook()"
          class="px-3 py-1 text-[9px] font-semibold rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all"
        >
          <i class="bi bi-printer mr-1"></i>Imprimir / PDF
        </button>
        <button
          onclick="closeFieldNotebook()"
          class="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/50 text-slate-400"
        >
          <i class="bi bi-x-lg text-[10px]"></i>
        </button>
      </div>
    </div>
    <div
      class="flex-1 overflow-y-auto scrollbar-none px-3 py-2 text-[10px] text-slate-700 dark:text-slate-200"
      id="field-notebook-content"
    ></div>
  </div>
</div>

<link rel="stylesheet" href="{% static 'css/soft-ui.css' %}?v=20260918a" />
{% endblock %} {% block scripts %} {{ block.super }}
<script>
/* Os 4 valores que o Django injectava no script de 772 KB.
 *
 * A interpolacao e' CRUA, e e' de proposito. A primeira versao desta
 * extraccao punha os valores em atributos `data-*` e lia-os com JSON.parse.
 * Isso partiu `culturas_do_produtor`: e' uma lista Python, e `|safe` em
 * Python-renderiza com ASPAS SIMPLES — `[{...'id': 7...}]`. Isso e'
 * JavaScript valido mas nao e' JSON, e `JSON.parse` devolve `[]`.
 *
 * O que a segunda versao faz e' o que o original fazia: mete o valor como
 * literal JavaScript, sem interpretar. O que muda e' o SITIO — 30 linhas
 * em vez de estar no meio de 772 KB. Zero mudanca de semantica.
 */
window._BOOTSTRAP = {
  culturas: {{ culturas_do_produtor|default:"[]"|safe }},
  presetBlock: {{ PRESET_BLOCK_JSON|default:"[]"|safe }},
