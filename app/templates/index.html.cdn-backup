      </button>
    </div>
    <div
      class="flex items-center gap-1 px-3 pt-2 pb-1 border-b border-slate-200 dark:border-slate-700/60 shrink-0 overflow-x-auto scrollbar-none"
      id="product-registry-tabs"
    >
      <button
        onclick="showProductTab('lista')"
