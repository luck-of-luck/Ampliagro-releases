{% extends "base.html" %} {% load static %} {% block extra_css %}
<link rel="stylesheet" href="{% static 'css/paginas/dashboard-index.css' %}?v=15" />
<link rel="stylesheet" href="{% static 'css/liquid-glass.css' %}?v=1" />
<style>
  /* =========================================================================
   RE-DESIGN: PAINEIS DE WIDGETS E EDIÇÃO (VIDRO TOTAL / FULL GLASS)
   ========================================================================= */
  #add-widget-modal-panel {
    background: rgba(10, 15, 20, 0.4) !important;
    backdrop-filter: blur(40px) saturate(200%) !important;
    -webkit-backdrop-filter: blur(40px) saturate(200%) !important;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;
    border-radius: 24px !important;
    color: #ffffff !important;
  }
  #add-widget-modal-panel::before,
  #add-widget-modal-panel::after,
  .widget-modal-box.lc-panel::before,
  .widget-modal-box.lc-panel::after {
    display: none !important;
  }
  #widget-modal-content {
    display: flex !important;
    flex-direction: column !important;
    min-height: 400px !important;
  }
  .tab-content {
    flex: 1 !important;
    height: 100% !important;
  }
  #kpi-accordion-container {
    width: 100% !important;
    min-height: 200px !important;
  }
  .edit-dropdown {
    background: rgba(10, 15, 20, 0.5) !important;
    backdrop-filter: blur(30px) saturate(200%) !important;
    -webkit-backdrop-filter: blur(30px) saturate(200%) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35) !important;
    border-radius: 16px !important;
    color: #fff !important;
    padding: 8px !important;
    position: absolute !important;
    z-index: 99999 !important;
  }
  #add-widget-modal-panel .text-slate-800,
  #add-widget-modal-panel .text-slate-700,
  #add-widget-modal-panel .text-slate-600,
  #add-widget-modal-panel .text-slate-500,
  #add-widget-modal-panel .text-slate-400 {
    color: #e2e8f0 !important;
  }
  .subgroup-pill {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: #f1f5f9 !important;
    padding: 8px 16px !important;
    border-radius: 12px !important;
    font-weight: 500 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    transition: all 0.2s !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  .subgroup-pill.active,
  .subgroup-pill:hover {
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
  }
  .widget-card {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
    border-radius: 16px !important;
    padding: 16px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    transition: all 0.2s !important;
    visibility: visible !important;
    opacity: 1 !important;
    min-height: 100px !important;
  }
  .widget-card:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    transform: translateY(-2px) !important;
  }
  .widget-card-icon {
    width: 40px !important;
    height: 40px !important;
    border-radius: 12px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 20px !important;
  }
  .widget-card-label {
    color: #e2e8f0 !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    text-align: center !important;
  }
</style>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- Dashboard Appbar Styles - WidgetBar Estilo Windows 11 -->

