            </svg>
          </div>
          <div class="nav-user-dropdown" id="user-dropdown" style="min-width: 280px">
            <div class="dropdown-header">
              <div class="name">
{% if user.is_authenticated %}{{ user.get_full_name|default:user.username }}{% else %}Visitante{% endif %}
              </div>
              <div class="email">{% if user.is_authenticated %}{{ user.email }}{% endif %}</div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="{% url 'perfil-config' %}"
              ><svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="3" />
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                />
              </svg>
              Configurações</a
            >
            <a href="{% url 'logout' %}" class="text-danger" onclick="logoutUser(event)"
              ><svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              Sair</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
<div class="nav-mode-dropdown nav-mode-panel is-centered hidden" id="mode-dropdown" role="menu">
  <div
    class="nav-mode-panel-grid"
    id="mode-panel-grid"
    style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px"
  >
    <div
      class="nav-mode-card is-active"
      data-preset="escuro"
      role="button"
      tabindex="0"
      onclick="selectPreset('escuro', event)"
    >
      <div class="nav-mode-card-head">
        <span class="nav-mode-card-title"><i class="bi bi-moon-stars"></i><span>Escuro</span></span
        ><span class="nav-mode-card-badge">Ativo</span>
      </div>
      <div class="nav-mode-card-preview">
        <div class="nmc-pv" style="background: #0b0f0e; border-color: #3ec48f">
          <div class="nmc-pv-nav" style="background: #131917; border-color: #3ec48f">
            <i class="nmc-pv-acc" style="background: #3ec48f"></i
            ><i class="nmc-pv-line" style="background: #8b9792"></i>
          </div>
          <div class="nmc-pv-row">
            <div
              class="nmc-pv-card"
              style="background: #151b19; border-color: rgba(62, 196, 143, 0.22)"
            >
              <span class="nmc-pv-vbar" style="background: #3ec48f; height: 55%"></span
              ><span class="nmc-pv-vbar" style="background: #3ec48f; height: 85%"></span>
            </div>
            <div
              class="nmc-pv-card nmc-pv-card-nest"
              style="background: #1a211f; border-color: rgba(62, 196, 143, 0.22)"
            >
              <i class="nmc-pv-acc" style="background: #57d7a0"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-mode-card-name">Escuro</div>
    </div>
    <div
      class="nav-mode-card"
      data-preset="claro"
      role="button"
      tabindex="0"
      onclick="selectPreset('claro', event)"
    >
      <div class="nav-mode-card-head">
        <span class="nav-mode-card-title"><i class="bi bi-sun"></i><span>Claro</span></span
        ><span class="nav-mode-card-badge">Ativo</span>
      </div>
      <div class="nav-mode-card-preview">
        <div class="nmc-pv" style="background: #f6f8f7; border-color: #0f9d6e">
          <div class="nmc-pv-nav" style="background: #fdfefe; border-color: #0f9d6e">
            <i class="nmc-pv-acc" style="background: #0f9d6e"></i
            ><i class="nmc-pv-line" style="background: #5f6b66"></i>
          </div>
          <div class="nmc-pv-row">
            <div
              class="nmc-pv-card"
              style="background: #fdfefe; border-color: rgba(15, 157, 110, 0.25)"
            >
              <span class="nmc-pv-vbar" style="background: #0f9d6e; height: 55%"></span
              ><span class="nmc-pv-vbar" style="background: #0f9d6e; height: 85%"></span>
            </div>
            <div
              class="nmc-pv-card nmc-pv-card-nest"
              style="background: #f3f7f5; border-color: rgba(15, 157, 110, 0.25)"
            >
              <i class="nmc-pv-acc" style="background: #4cc396"></i>
            </div>
          </div>
        </div>
