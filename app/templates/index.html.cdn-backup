    <div
      class="px-3 py-1.5 border-t border-slate-200 dark:border-slate-700/60 flex items-center gap-3 text-[7px] text-slate-400"
    >
      <span
        ><kbd
          class="px-1 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono border border-slate-200 dark:border-slate-700"
          >&uarr;&darr;</kbd
        >
        Navegar</span
      >
      <span
        ><kbd
          class="px-1 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono border border-slate-200 dark:border-slate-700"
          >&crarr;</kbd
